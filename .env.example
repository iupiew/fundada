# Blockfrost project ID (https://blockfrost.io). Required.
# The first 7 characters select the network: mainnet... / preprod... / preview...
PUBLIC_FUNDADA_BLOCKFROST_PROJECT_ID=preprod...

# Optional: override the network inferred from the project ID prefix.
# Must match the project ID prefix. One of: mainnet, preprod, preview.
# PUBLIC_FUNDADA_NETWORK=preprod

# Optional: base URL for a self-hosted/private Blockfrost instance.
# PUBLIC_FUNDADA_BLOCKFROST_URL=
