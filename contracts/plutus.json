    "campaign/CampaignDatum": {
      "title": "CampaignDatum",
      "description": "Datum attached to the campaign's single head UTxO — the one that always\n carries the thread token. `pledges` is the complete, authoritative list\n of every backer's contribution so far. `title`/`description`/`links` are\n immutable campaign metadata, now explicitly protected on every state\n transition (see the equality checks in each branch below) instead of\n silently allowed to change on withdraw as before.",
      "anyOf": [
        {
          "title": "CampaignDatum",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "founder",
              "$ref": "#/definitions/aiken~1crypto~1VerificationKeyHash"
            },
