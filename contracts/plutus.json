    "campaign/Pledge": {
      "title": "Pledge",
      "description": "A single backer's contribution, tracked as an entry inside the\n campaign's one authoritative state UTxO (the \"head\"). This is what\n replaces trying to reconstruct \"total pledged\" by summing whatever\n UTxOs happen to be included in a given transaction — that approach is\n trivially gameable (a transaction can simply omit other backers' UTxOs),\n so the total must instead live in one UTxO that every pledge, withdraw,\n and refund is forced to read and update atomically.",
      "anyOf": [
        {
          "title": "Pledge",
          "dataType": "constructor",
          "index": 0,
